      "service": "ai4bharat/translation",
      "at": "2026-08-25T00:00:00.000Z"
    },
    "neema-dadi.l9": {
      "source": "नीमा दौड़कर दादी की चप्पलें ले आई।",
      "target": "ᱱᱤᱢᱟ ᱰᱟᱹᱨᱚᱢ ᱰᱟᱦᱟᱨᱟᱢ ᱥᱟᱨᱤ ᱠᱟᱹᱨᱚᱢ ᱟᱢᱮ",
      "en": "Neema ran and fetched grandmother's slippers.",
