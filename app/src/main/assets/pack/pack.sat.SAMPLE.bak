      "service": "ai4bharat/translation",
      "at": "2026-08-25T00:00:00.000Z"
    },
    "neema-dadi.l10": {
      "source": "फिर वे दोनों खेल के मैदान की ओर चल पड़े।",
      "target": "ᱰᱟᱝ ᱥᱚᱢᱟᱭ ᱟᱨᱚᱢᱚᱢ ᱠᱟᱹᱨᱚᱢ ᱰᱟᱝ ᱟᱨᱚᱢ ᱠᱟᱹᱨᱚᱢ",
      "en": "Then the two of them set off towards the playground.",
