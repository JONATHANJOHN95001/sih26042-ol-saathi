<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Light only, on purpose. The palette below has no night variant, so a
      DayNight parent paired light backgrounds with the dark theme's white text
      whenever the phone was in dark mode: the language picker and every other
      view that reads its colour from the theme went white on cream (seen on a
      OnePlus Nord 5, Android 16). forceDarkAllowed stops OxygenOS's "dark mode
      for third-party apps" from inverting it instead.
    -->
    <style name="Theme.OlSaathi" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!--
          targetSdk 35 makes Android 15+ draw every screen edge to edge, and no
          layout here reserves space for the bars: on the Nord 5 the toolbar
          title sat under the clock, the overflow menu (Import PDF, Check and
          Proof) under the battery icon, and the bottom buttons under the
          gesture bar. This restores the normal system-bar insets. It stops
          working at targetSdk 36; per-screen insets are the lasting fix.
        -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <!-- Primary -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <!-- Error -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorSurfaceDim">@color/md_theme_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_surfaceBright</item>
        <!-- Surface Containers -->
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>
        <!-- Inverse -->
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <!-- ── Typography ────────────────────────────────────────── -->
        <!-- Material components read the type scale, not android:fontFamily,
             so both are set: the scale reaches MaterialButton and the
             toolbars, the plain attributes reach the 47 bare TextViews. -->
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.OlSaathi.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.OlSaathi.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.OlSaathi.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.OlSaathi.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.OlSaathi.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.OlSaathi.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.OlSaathi.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OlSaathi.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.OlSaathi.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.OlSaathi.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.OlSaathi.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.OlSaathi.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.OlSaathi.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.OlSaathi.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.OlSaathi.LabelSmall</item>
        <!-- ── Shape ─────────────────────────────────────────────── -->
        <!-- 12dp, the roundness the design system specifies. Material3
             buttons default to a stadium shape; these components are soft
             rectangles, so the corner tokens are set rather than left. -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.OlSaathi.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.OlSaathi.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.OlSaathi.Large</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.OlSaathi.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.OlSaathi.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.OlSaathi.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.OlSaathi.Large</item>
        <item name="materialCardViewStyle">@style/Widget.OlSaathi.CardView</item>
        <!-- System -->
        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <item name="android:navigationBarColor">@color/md_theme_surface</item>
    </style>

    <!-- Soft rectangles, not stadiums. -->
    <style name="Shape.OlSaathi.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Shape.OlSaathi.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.OlSaathi.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- The design system uses a hairline border and no drop shadow. Depth is
         carried by surface tone, so elevation is zero by default. -->
    <style name="Widget.OlSaathi.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="cardBackgroundColor">@color/md_theme_surfaceContainer</item>
    </style>

    <style name="TextAppearance.OlSaathi.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
    <style name="TextAppearance.OlSaathi.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/noto_sans</item>
        <item name="android:fontFamily">@font/noto_sans</item>
    </style>
</resources>
