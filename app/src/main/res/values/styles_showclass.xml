<?xml version="1.0" encoding="utf-8"?>
<!-- Show the class, after the design mockup. -->
<resources>
    <style name="ShowClass" />

    <style name="ShowClass.ReadAloud" parent="Widget.Material3.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_teach_showclass</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ShowClass.Speed" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_teach_speed</item>
        <item name="android:textColor">#0F3822</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ShowClass.Close" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_showclass_close</item>
        <item name="android:textColor">#0F3822</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
