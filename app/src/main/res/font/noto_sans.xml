<?xml version="1.0" encoding="utf-8"?>
<!--
    Noto Sans, subset to Latin. The Devanagari and Ol Chiki faces are loaded
    separately from assets/fonts via Typeface.createFromAsset, because those
    are applied per-TextView to target-language text rather than app-wide.
    Anything this family cannot render falls back to the system Noto face,
    which is the same typeface design, so the seam is invisible.

    Subset from the upstream 2.4 MB set to 218 MB total. The full faces carry
    Greek and Cyrillic this app will never show.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/noto_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/noto_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/noto_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/noto_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/noto_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/noto_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/noto_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/noto_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
