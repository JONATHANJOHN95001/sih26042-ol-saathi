<?xml version="1.0" encoding="utf-8"?>
<!--
  The only screen a child ever looks at.

  The teacher turns the tablet around, so this has to read from a metre away
  across a classroom, not from arm's length. Everything is oversized, there is
  no chrome, and the two controls that remain sit in corners where a child's
  eye will not land first.

  Works in both orientations on purpose: a teacher turning a tablet to face the
  class usually turns it landscape.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- The picture. A pre-literate child reads this before any text. -->
        <ImageView
            android:id="@+id/imageCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:minHeight="120dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- Santali, the largest thing on screen. It is the output being
             taught and it is unfamiliar to everyone in the room. -->
        <!-- Auto-sized, not fixed. A one-word phrase and a full lesson
             sentence both have to fill this space without pushing the
             picture off the screen. -->
        <TextView
            android:id="@+id/textTarget"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/md_theme_primary"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="22sp"
            app:autoSizeMaxTextSize="60sp"
            app:autoSizeStepGranularity="1sp" />

        <!-- Hindi underneath, deliberately smaller. -->
        <TextView
            android:id="@+id/textSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="@color/md_theme_onSurfaceVariant" />

    </LinearLayout>

    <!-- Close, top right, small and out of the way. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/show_class_close"
        android:textSize="20sp"
        app:cornerRadius="28dp"
        style="@style/Widget.Material3.Button.TextButton" />

    <!-- Play, bottom right. Hidden unless this line actually has audio. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/show_class_play"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TonalButton" />

</FrameLayout>
