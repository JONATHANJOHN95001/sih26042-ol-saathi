<?xml version="1.0" encoding="utf-8"?>
<!--
    The language picker, shared by the Teach screen and the worksheet screen.

    It lives in one file because the teacher's choice is one choice: picking
    Marathi to speak and then printing a Santali worksheet is the confusion
    this is meant to prevent, and two copies of a picker drift apart.

    The note underneath is not decoration. It carries the two things a teacher
    cannot see for themselves: whether this language has audio at all, and
    whether the build could vouch for its script. Both are read from the pack
    manifest, never hardcoded.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@color/md_theme_surfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:paddingEnd="8dp" />

        <Spinner
            android:id="@+id/spinnerLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:contentDescription="@string/language_label" />
    </LinearLayout>

    <TextView
        android:id="@+id/textLanguageNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:paddingTop="2dp"
        android:visibility="gone"
        android:text="" />

</LinearLayout>
