<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_primary"
        app:title="Lessons"
        app:titleTextColor="@color/md_theme_onPrimary"
        app:menu="@menu/overflow_menu" />

    <!--
        The same picker the Teach and Materials screens use. A teacher who
        wants a lesson in Tamil had to go to another screen to say so and then
        come back, which is how a class ends up looking at the wrong language.
    -->
    <include
        android:id="@+id/languageBar"
        layout="@layout/view_language_bar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_lesson"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <!-- Any lesson PDF becomes a worksheet and flashcards, NIPUN tagged. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="56dp"
        android:text="@string/btn_add_lesson_pdf"
        android:textSize="16sp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- One tap from the first screen to the requirement-by-requirement proof. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="56dp"
        android:text="✓ SIH26042 proof for judges"
        android:textSize="16sp"
        style="@style/Widget.Material3.Button.TonalButton" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLessons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
