<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_translation"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/speak_hindi_output_ho"
            android:textSize="16sp"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:layout_marginBottom="8dp" />

        <!-- Two-Way Conversation Mode Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_two_way"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Two-Way Conversation"
                android:textSize="14sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_marginEnd="8dp" />

            <!-- Latency SLA Banner -->
            <TextView
                android:id="@+id/tv_latency_sla"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="@color/md_theme_secondary"
                android:gravity="end"
                android:visibility="gone"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_chip_secondary" />
        </LinearLayout>

        <!-- Two-Way Mode: Teacher/Student Toggle Buttons -->
        <LinearLayout
            android:id="@+id/two_way_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_teacher_hindi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Teacher (Hindi)"
                android:textSize="13sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/md_theme_primaryContainer"
                android:textColor="@color/md_theme_onPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_student_santhali"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Student (Santhali)"
                android:textSize="13sp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/md_theme_secondaryContainer"
                android:textColor="@color/md_theme_onSecondaryContainer" />
        </LinearLayout>

        <!-- Bilingual Translation Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Source (Hindi) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/source_hindi"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:textColor="@color/md_theme_outline"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_source_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ready"
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_source_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/press_hold_speak"
                    android:textSize="20sp"
                    android:textColor="@color/md_theme_onSurface"
                    android:textColorHint="@color/md_theme_outline"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/md_theme_surfaceContainerHigh"
                android:layout_marginBottom="12dp" />

            <!-- Translation (Ho/Santhali) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_output_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/translation_ho"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:textColor="@color/md_theme_secondary"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt; 1.2s"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_secondary"
                        android:background="@drawable/bg_chip_secondary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_target_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp" />

                <TextView
                    android:id="@+id/tv_output_provenance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/provenance_translit"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_secondary"
                    android:background="@drawable/bg_chip_secondary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Waveform + PTT Button Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_card_surface_variant"
            android:layout_marginBottom="16dp">

            <!-- Waveform visualization (hidden by default) -->
            <LinearLayout
                android:id="@+id/waveform_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <View android:id="@+id/wave_bar_1" android:layout_width="6dp" android:layout_height="20dp"
                    android:layout_marginHorizontal="4dp" android:background="@drawable/bg_waveform_bar"
                    android:alpha="0.2" />
                <View android:id="@+id/wave_bar_2" android:layout_width="6dp" android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp" android:background="@drawable/bg_waveform_bar"
                    android:alpha="0.3" />
                <View android:id="@+id/wave_bar_3" android:layout_width="6dp" android:layout_height="60dp"
                    android:layout_marginHorizontal="4dp" android:background="@drawable/bg_waveform_bar"
                    android:alpha="0.4" />
                <View android:id="@+id/wave_bar_4" android:layout_width="6dp" android:layout_height="40dp"
                    android:layout_marginHorizontal="4dp" android:background="@drawable/bg_waveform_bar"
                    android:alpha="0.3" />
                <View android:id="@+id/wave_bar_5" android:layout_width="6dp" android:layout_height="20dp"
                    android:layout_marginHorizontal="4dp" android:background="@drawable/bg_waveform_bar"
                    android:alpha="0.2" />
            </LinearLayout>

            <!-- PTT Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ptt_speak"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:backgroundTint="@color/md_theme_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@android:drawable/ic_btn_speak_now"
                    app:iconTint="@color/md_theme_onPrimary"
                    app:iconSize="36dp"
                    app:cornerRadius="40dp"
                    app:rippleColor="@color/md_theme_primaryFixed" />

                <TextView
                    android:id="@+id/tv_speak_instruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hold_to_speak_hindi"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Visual Aid Flashcard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_tertiary"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/visual_aid"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onTertiaryContainer" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/md_theme_onTertiaryContainer"
                    android:contentDescription="Visual Aid" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/flashcard_container"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/iv_flashcard"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Flashcard image" />

                <TextView
                    android:id="@+id/tv_flashcard_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keywords_appear_here"
                    android:textSize="16sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Flashcard Word Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_prev_words"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/previous_words"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onTertiaryContainer"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_hati"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Hati (Elephant)"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:alpha="0.5"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_gachh"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Gachh (Tree)"
                        android:textSize="13sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:alpha="0.5" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
