<?xml version="1.0" encoding="utf-8"?>
<!-- One language in the "Teach in which language?" sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_lang_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/textLangEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1C1917"
                    tools:text="Santali" />

                <TextView
                    android:id="@+id/textLangEndonym"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="18sp"
                    android:textColor="#44403C"
                    tools:text="ᱥᱟᱱᱛᱟᱲᱤ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textLangRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_lang_tag_region"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="JHARKHAND"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#9C441D"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textLangScript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lang_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textSize="12sp"
                    android:textColor="#44403C"
                    tools:text="Ol Chiki script" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imageLangCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_lang_check"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lang_card_footer"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/textLangAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="🔊 Recorded audio" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textLangLines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#57534E"
            tools:text="53 lines" />
    </LinearLayout>
</LinearLayout>
