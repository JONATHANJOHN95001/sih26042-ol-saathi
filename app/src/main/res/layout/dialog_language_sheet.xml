<?xml version="1.0" encoding="utf-8"?>
<!--
  "Teach in which language?", after the Choose Language design: a
  search field, one card per language pack on this tablet, and a confirm bar.
  Every figure on a card (script, recorded audio, line count) is read from
  the pack manifest, never typed in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8F5"
    android:theme="@style/ThemeOverlay.Teach">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="16dp"
        android:paddingTop="22dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_mat_dot_orange" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Teach in which language?"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0F3822" />

        <ImageButton
            android:id="@+id/btnSheetClose"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_showclass_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:id="@+id/textSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="28dp"
        android:paddingTop="4dp"
        android:textSize="15sp"
        android:textColor="#44403C" />

    <EditText
        android:id="@+id/editSheetSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_showclass_card"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Find a language (e.g. Santali, বাংলা, Tamil)…"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:textColor="#1C1917"
        android:textColorHint="#A8A29E" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="22dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/textSheetSelected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textColor="#292524" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetCancel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minHeight="56dp"
            android:paddingHorizontal="28dp"
            android:text="✓  Use this language"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F3822" />
    </LinearLayout>
</LinearLayout>
