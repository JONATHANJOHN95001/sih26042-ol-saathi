<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_primary"
        app:titleTextColor="@color/md_theme_onPrimary"
        app:navigationIconTint="@color/md_theme_onPrimary" />

    <!--
        The same picker the other screens use. A lesson is the one place a
        teacher is most likely to want another language, and until now this was
        the one screen that could not change it.
    -->
    <include
        android:id="@+id/languageBar"
        layout="@layout/view_language_bar" />

    <!-- Counter at top-right -->
    <TextView
        android:id="@+id/textCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        android:textSize="14sp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp" />

    <!-- Progress dots -->
    <LinearLayout
        android:id="@+id/progressDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="28dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Section label (HINDI or ASK THE CLASS) -->
            <TextView
                android:id="@+id/textSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HINDI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="6dp" />

            <!-- Hindi card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/textHindi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/md_theme_onSurface"
                    android:padding="16dp"
                    android:text="" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Target language label. Text is set in code from the loaded
                 pack: hardcoding Santali here was wrong once a language
                 dropdown existed. -->
            <TextView
                android:id="@+id/textTargetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/target_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="6dp" />

            <!-- Santali card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainerLow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="30sp"
                        android:lineSpacingMultiplier="1.6"
                        android:textColor="@color/md_theme_secondary"
                        android:text="" />

                    <!--
                        The margin is not padding taste. Ol Chiki glyphs carry ink
                        below the baseline that the font's own descent metric does
                        not fully cover, so a chip drawn immediately underneath a
                        30sp target line lands on top of the descenders. Seen on
                        the lesson player on a real device. The other Indic faces
                        behave the same way to a lesser degree, so the clearance
                        is given here rather than tuned per script.
                    -->
                    <TextView
                        android:id="@+id/textProvenance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:layout_marginTop="14dp"
                        android:paddingTop="8dp"
                        android:text="" />

                    <!-- Reviewer info (shown for HUMAN_VERIFIED) -->
                    <TextView
                        android:id="@+id/textReviewer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/human_verified_blue"
                        android:paddingTop="2dp"
                        android:visibility="gone"
                        android:text="" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Play button (large circular) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowClass"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_show_class"
                android:textSize="16sp"
                style="@style/Widget.Material3.Button"
                android:minHeight="56dp"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginVertical="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_play"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:minHeight="64dp"
                    style="@style/Widget.Material3.Button.TonalButton" />

                <!-- Repeat speed. A class echoing a phrase back needs it
                     slower than a teacher checking their own pronunciation,
                     so this stays on until it is turned off. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:text="0.75x"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

            <!-- Sits under the play button because it describes what you are
                 about to hear, which is not always the same claim as the text
                 label above it. -->
            <TextView
                android:id="@+id/textAudioProvenance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="11sp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:text=""
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Navigation buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="← Back"
            android:textSize="14sp"
            android:visibility="invisible"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:minHeight="56dp"
        />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Next →"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button"
            android:minHeight="56dp"
        />
    </LinearLayout>

</LinearLayout>
