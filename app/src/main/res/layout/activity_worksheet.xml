<?xml version="1.0" encoding="utf-8"?>
<!--
  Materials, portrait.

  Laid out as numbered parameters rather than a stack of buttons, so a teacher
  reads it as a form with a result: choose the lesson, see which published
  NIPUN outcome it is aligned to, choose the worksheet type and how many
  activities, then print. The live A4 preview comes first, the full width of
  the screen at A4 proportions, and the parameters follow it in the same
  scroll: a page shrunk into half a phone screen was too small to read, and a
  teacher checks the sheet before changing it. In landscape it becomes the
  right pane. The tag "fullWidth" tells WorksheetActivity to size the render
  by width alone.

  Worksheet-type names, Hindi subtitles and NIPUN codes are set in code from
  the WorksheetType enum, which is the single source of those strings.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_primary"
        app:title="Materials"
        app:titleTextColor="@color/md_theme_onPrimary"
        app:navigationIconTint="@color/md_theme_onPrimary"
        app:menu="@menu/overflow_menu" />

    <include
        android:id="@+id/languageBar"
        layout="@layout/view_language_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/previewSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:paddingBottom="6dp" />

                <FrameLayout
                    android:id="@+id/previewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="fullWidth"
                    android:background="@drawable/bg_card_surface_variant"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/textPreviewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_generating"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:paddingTop="6dp" />

                <!-- Right under the page it saves, shown once Generate has
                     produced the file the preview is showing. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="56dp"
                    android:text="@string/btn_save_as_pdf"
                    android:textSize="16sp"
                    android:visibility="gone"
                    style="@style/Widget.Material3.Button" />
            </LinearLayout>

            <TextView
                android:id="@+id/textWorksheetIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/worksheet_intro_default"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="20dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. LESSON (पाठ चयन)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <Spinner
                    android:id="@+id/spinnerLesson"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/worksheet_type_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/gridWorksheetTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/typeContainerTraceConnect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_param_tile"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/typeNameTraceConnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="Trace and Connect" />

                        <TextView
                            android:id="@+id/typeHindiTraceConnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            tools:text="चित्र-वाक्य मिलान" />

                        <TextView
                            android:id="@+id/typeCodeTraceConnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_nipun_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/nipun_chip_ink"
                            tools:text="ECL2 4.5" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/typeContainerWordStrips"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_param_tile"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/typeNameWordStrips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="Word Flash Strips" />

                        <TextView
                            android:id="@+id/typeHindiWordStrips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            tools:text="कट-आउट शब्द पट्टियां" />

                        <TextView
                            android:id="@+id/typeCodeWordStrips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_nipun_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/nipun_chip_ink"
                            tools:text="ECL1 4.8" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/typeContainerScriptTracing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_param_tile"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/typeNameScriptTracing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="Script Tracing" />

                        <TextView
                            android:id="@+id/typeHindiScriptTracing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            tools:text="अक्षर अभ्यास" />

                        <TextView
                            android:id="@+id/typeCodeScriptTracing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_nipun_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/nipun_chip_ink"
                            tools:text="ECL2 4.5" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/typeContainerDialogues"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_param_tile"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/typeNameDialogues"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            tools:text="Classroom Dialogues" />

                        <TextView
                            android:id="@+id/typeHindiDialogues"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            tools:text="संवाद अभ्यास" />

                        <TextView
                            android:id="@+id/typeCodeDialogues"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_nipun_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/nipun_chip_ink"
                            tools:text="ECL2 4.1a" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_count_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/rowActivityCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tileCount2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_param_tile"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="2" />

                <TextView
                    android:id="@+id/tileCount3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_param_tile"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="3" />

                <TextView
                    android:id="@+id/tileCount4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_param_tile"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="4" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. NIPUN BHARAT OUTCOME (निपुण भारत लक्ष्य)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNipun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textNipunCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_nipun_chip"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/nipun_chip_ink"
                        tools:text="ECL2 4.1a" />

                    <TextView
                        android:id="@+id/textNipunOutcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="14sp"
                        android:textColor="@color/md_theme_onSurface"
                        tools:text="Listens to words, greetings, polite forms of expression, and responding in home language." />

                    <TextView
                        android:id="@+id/textNipunSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:text="Published outcome, CBSE Class 1 mapping" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_marginBottom="8dp"
                android:text="Generate Worksheet"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Generate Flashcards"
                android:textSize="16sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <!-- Was reachable only from the overflow menu, which on phones
                 that draw under the status bar was not reachable at all. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_import_pdf"
                android:textSize="16sp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingVertical="16dp"
                android:textSize="14sp"
                android:text="" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_save"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_share"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TonalButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/btn_print"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
