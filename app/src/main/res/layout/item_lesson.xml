<?xml version="1.0" encoding="utf-8"?>
<!--
  A lesson card, after the Lessons design: white card with a
  terracotta-to-forest edge, the mother tongue first, Hindi under it as the
  gloss, and a listen button that plays the line from the offline pack.

  The line shown is the first real phrase of the lesson, not an invented
  title. Nothing here is written in a target script by hand, and the listen
  button is hidden when that line has no recorded clip, so it never offers
  a sound it cannot play.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="14dp"
    android:minHeight="56dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:strokeColor="#E7E5E4"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lessons_stripe" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:paddingVertical="16dp">

            <!-- The anchor. Indic scripts need the line height, so 1.55 is
                 the floor the system sets for any target-language text. -->
            <TextView
                android:id="@+id/textTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.55"
                android:letterSpacing="0.04"
                android:textColor="#B85828"
                android:visibility="gone"
                tools:text="ᱡᱚᱦᱟᱨ ᱜᱤᱫᱽᱨᱟᱹᱠᱚ ᱾"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textHindi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="15sp"
                android:textColor="#292524"
                android:visibility="gone"
                tools:text="नमस्ते बच्चों।"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1C1917"
                tools:text="Classroom Phrases" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#78716C"
                tools:text="40 phrases" />

            <!-- The published NIPUN outcome this lesson is aligned to, exactly
                 as the pack carries it. -->
            <TextView
                android:id="@+id/textNipun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_lessons_nipun"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#064E3B"
                android:visibility="gone"
                tools:text="NIPUN ECL2 4.1a"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnListen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_lessons_listen"
            android:src="@drawable/ic_lessons_volume"
            android:contentDescription="Listen to this line"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
