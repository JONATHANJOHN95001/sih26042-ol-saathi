<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qr_fallback_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_surface"
    android:padding="20dp"
    android:layout_marginBottom="16dp"
    android:layout_marginTop="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/md_theme_tertiary"
            android:layout_marginEnd="8dp"
            android:contentDescription="QR Sync" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QR Code Sync Fallback"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_tertiary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Optical data transfer when Wi-Fi Direct fails"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- QR Code Display -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_surface_variant"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="QR Code for sync" />

        <TextView
            android:id="@+id/tv_qr_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Tap 'Generate QR' to create sync code"
            android:textSize="14sp"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:gravity="center" />
    </FrameLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_qr"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Generate QR"
            android:textSize="13sp"
            android:backgroundTint="@color/md_theme_tertiary"
            android:textColor="@color/md_theme_onTertiary"
            android:layout_marginEnd="6dp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_view"
            app:iconTint="@color/md_theme_onTertiary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_qr"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Scan QR"
            android:textSize="13sp"
            android:textColor="@color/md_theme_tertiary"
            android:layout_marginStart="6dp"
            app:strokeColor="@color/md_theme_tertiary"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@color/md_theme_tertiary" />
    </LinearLayout>

    <!-- Help text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compresses student progress via GZIP → encodes to QR → teacher scans to sync. Works 100% offline."
        android:textSize="11sp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:alpha="0.7"
        android:layout_marginTop="8dp" />
</LinearLayout>
