<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Welcome Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_surface"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/johar_educator"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/class3_nipun_goals"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_voice_assistant"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/voice_assistant"
                android:textColor="@color/md_theme_onPrimary"
                android:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_btn_speak_now"
                app:iconTint="@color/md_theme_onPrimary"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- NIPUN Bharat Outcomes Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nipun_bharat_outcomes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface"
            android:layout_marginBottom="12dp" />

        <!-- Metrics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Active Students -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/active_students"
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_student_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42/45"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/present_today"
                    android:textSize="11sp"
                    android:textColor="@color/md_theme_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Math Mastery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp"
                android:layout_marginHorizontal="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/math_mastery_l2"
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_mastery_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="68%"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:max="100"
                    android:progress="68"
                    android:progressDrawable="@drawable/bg_progress_bar_green"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Literacy Santhali -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_surface"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/literacy_santhali"
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="82%"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:max="100"
                    android:progress="82"
                    android:progressDrawable="@drawable/bg_progress_bar_blue"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Learning Gap Analysis Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/learning_gap_analysis"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_details"
                    android:textSize="12sp"
                    android:textColor="@color/md_theme_primary" />
            </LinearLayout>

            <in.gov.tribalfln.ui.LearningGapRadarView
                android:id="@+id/radar_view"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_card_surface_variant" />
        </LinearLayout>

        <!-- Quick Actions Grid -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- OCR Grade -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ocr_grade"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/ocr_grade"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onTertiaryContainer"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="@color/md_theme_tertiaryContainer"
                app:iconGravity="top"
                app:cornerRadius="12dp" />

            <!-- Generate Worksheet -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate_worksheet"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="@string/generate_worksheet"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onPrimaryContainer"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/md_theme_primary"
                app:iconGravity="top"
                app:cornerRadius="12dp" />

            <!-- P2P Mesh Sync -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mesh_sync"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/p2p_mesh_sync"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onSecondaryContainer"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="@color/md_theme_secondaryContainer"
                app:iconGravity="top"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Secondary Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_data"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/share_data"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_progress"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/view_progress"
                android:textSize="13sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Class Progress Review Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_secondary"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/md_theme_onSecondaryContainer"
                android:layout_marginEnd="12dp"
                android:contentDescription="School" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/class_progress_review"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSecondaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/class_progress_desc"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_onSecondaryContainer"
                    android:alpha="0.8"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
