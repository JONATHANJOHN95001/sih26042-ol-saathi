<?xml version="1.0" encoding="utf-8"?>
<!--
  Materials, landscape: the form left (~40%), live A4 preview right (~60%).

  Every view id here must exist in the portrait layout too, or ViewBinding
  throws at inflation on whichever orientation was forgotten. The form is the
  shared view_worksheet_form.xml, so only the frame around it lives here:
  toolbar, language card, preview pane, bottom navigation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8F4"
    android:theme="@style/ThemeOverlay.Materials">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E4B38"
        app:title="Materials"
        app:titleTextColor="#FFFFFF"
        app:titleTextAppearance="@style/TextAppearance.Materials.Title"
        app:navigationIconTint="#FFFFFF"
        app:menu="@menu/overflow_menu">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_mat_offline_chip"
            android:drawableStart="@drawable/bg_mat_dot_green_small"
            android:drawablePadding="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Offline pack ready"
            android:textSize="11sp"
            android:textColor="#C8EEDB" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ── Left: language and form, ~40% ─────────────────────── -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_mat_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_mat_icon_mint"
                        android:gravity="center"
                        android:text="🌐"
                        android:textSize="18sp" />

                    <include
                        android:id="@+id/languageBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        layout="@layout/view_language_bar" />
                </LinearLayout>

                <include
                    android:id="@+id/form"
                    layout="@layout/view_worksheet_form" />

            </LinearLayout>
        </ScrollView>

        <!-- ── Right: live A4 preview, ~60% ───────────────────────── -->
        <LinearLayout
            android:id="@+id/previewSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#527464"
                android:paddingBottom="6dp" />

            <FrameLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mat_card"
                android:padding="8dp" />

            <TextView
                android:id="@+id/textPreviewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_generating"
                android:textSize="11sp"
                android:textColor="#527464"
                android:paddingTop="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="@string/btn_save_as_pdf"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
