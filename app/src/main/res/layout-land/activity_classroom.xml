<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape Teach screen: the dual-pane split the design system calls for.

  A tablet held landscape wastes half its width on a single scrolling column
  and pushes the target language below the fold. Split instead: the teacher's
  controls on the left, the line being taught on the right, so speaking and
  reading out never scroll each other off screen. Styled after the
  "Ol Saathi UI redesign", like the portrait layout.

  Every id in the portrait layout appears here too. ViewBinding generates one
  class from both, and a missing id would turn the field nullable and break
  ClassroomActivity at compile time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FBF8F1"
    android:theme="@style/ThemeOverlay.Teach">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_teach_header"
        app:title="Ol Saathi"
        app:titleTextColor="#FFFFFF"
        app:subtitleTextColor="#C8EEDB"
        app:titleTextAppearance="@style/TextAppearance.Teach.Title"
        app:navigationIconTint="#FFFFFF"
        app:menu="@menu/overflow_menu">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_teach_dot_amber" />
    </com.google.android.material.appbar.MaterialToolbar>

    <include
        android:id="@+id/languageBar"
        layout="@layout/view_language_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="16dp">

        <!-- ── Left, 40%: what the teacher does ──────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <!-- Primary capture, held down while speaking. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceInput"
                style="@style/Teach.Pill.Speak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:text="@string/hold_to_speak" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editHindiInput"
                style="@style/Teach.Input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:hint="@string/type_hint"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSend" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualTranslate"
                style="@style/Teach.Pill.Translate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_translate" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Turn the tablet around. Bottom of the teacher's column, so it
                 is the last thing reached and never mistaken for Translate. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowClass"
                style="@style/Teach.Pill.ShowClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:text="@string/btn_show_class"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ── Right, 60%: the line being taught ─────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="60"
            android:background="@drawable/bg_teach_workspace"
            android:orientation="vertical"
            android:padding="20dp">

            <ScrollView
                android:id="@+id/scrollTranslation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Teach.BadgeHindi"
                            android:text="अ HINDI" />

                        <TextView
                            style="@style/Teach.LabelText"
                            android:text="Hindi" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="19sp"
                        android:textColor="#1C1917"
                        android:paddingTop="8dp"
                        android:text="" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginVertical="16dp"
                        android:src="@drawable/ic_teach_divider"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textTargetBadge"
                            style="@style/Teach.BadgeTarget" />

                        <TextView
                            android:id="@+id/textTargetLabel"
                            style="@style/Teach.LabelText"
                            android:text="@string/target_label" />
                    </LinearLayout>

                    <!-- The dominant element. Indic scripts need the line
                         height; 1.55 is the system's floor. -->
                    <TextView
                        android:id="@+id/textTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="34sp"
                        android:lineSpacingMultiplier="1.6"
                        android:textColor="#B84310"
                        android:paddingTop="8dp"
                        android:text="" />

                    <TextView
                        android:id="@+id/textProvenance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="12sp"
                        android:textColor="#78716C"
                        android:text="" />

                </LinearLayout>
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayAudio"
                style="@style/Teach.Pill.Play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="Play" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed"
                style="@style/Teach.SpeedChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

            <!-- Kept apart from the text provenance above: a line can be
                 machine translated and still read aloud by a Santali
                 speaker, which makes the audio the more trustworthy half. -->
            <TextView
                android:id="@+id/textAudioProvenance"
                style="@style/Teach.Note"
                android:layout_marginTop="6dp"
                android:text=""
                android:visibility="gone" />

            <TextView
                android:id="@+id/textAudioStatus"
                style="@style/Teach.Note"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_teach_speaker"
                android:drawablePadding="6dp"
                android:text=""
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAF7F0"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
