<?xml version="1.0" encoding="utf-8"?>
<!--
  Show the class, landscape: the picture on the left, the words and the
  "Read aloud" control on the right. Same ids as the portrait layout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_showclass_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="32dp"
        android:paddingTop="40dp"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/imageCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="45"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_showclass_card"
            android:padding="32dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="55"
            android:background="@drawable/bg_showclass_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <TextView
                android:id="@+id/textTarget"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:textColor="#0F3822"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="28sp"
                app:autoSizeMaxTextSize="84sp"
                app:autoSizeStepGranularity="2sp" />

            <TextView
                android:id="@+id/textSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#B84310" />

            <TextView
                android:id="@+id/textGloss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="#57534E"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    style="@style/ShowClass.ReadAloud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_class_play"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeed"
                    style="@style/ShowClass.Speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/ShowClass.Close"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:text="@string/show_class_close" />

</FrameLayout>
