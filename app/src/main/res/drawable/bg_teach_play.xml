<?xml version="1.0" encoding="utf-8"?>
<!-- Play pill: warm stone gradient. Disabled fades, so a line with no
     audio does not look pressable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#F1ECE3" /><stroke android:width="1dp" android:color="#E4DCCD" /><corners android:radius="999dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="270" android:startColor="#E4DDD0" android:endColor="#D5CCBC" /><stroke android:width="1dp" android:color="#D5CCBD" /><corners android:radius="999dp" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="270" android:startColor="#EAE3D6" android:endColor="#DDD5C5" /><stroke android:width="1dp" android:color="#D5CCBD" /><corners android:radius="999dp" /></shape>
    </item>
</selector>
