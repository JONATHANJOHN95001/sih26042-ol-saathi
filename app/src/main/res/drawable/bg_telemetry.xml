<?xml version="1.0" encoding="utf-8"?>
<!-- Surface behind a diagnostics readout. Same tokens as MaterialCardView so
     the telemetry blocks sit in the same material as every other card, without
     nesting a card around each one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md_theme_surfaceContainer" />
    <stroke
        android:width="1dp"
        android:color="@color/md_theme_outlineVariant" />
    <corners android:radius="12dp" />
</shape>
